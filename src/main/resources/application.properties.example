# Example Local / Production Configuration Template
# Copy this file to application-local.properties or set environment variables locally.
# DO NOT commit sensitive passwords/keys to GitHub.

# Database Credentials (MySQL)
# Example MySQL Connection String:
# DB_URL=jdbc:mysql://localhost:3306/giasuhq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your-mysql-db-password

DB_URL=jdbc:mysql://localhost:3306/giasuhq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Frontend CORS URL
CORS_ORIGINS=http://localhost:5173

# Email provider. Use "smtp" locally or "resend" on Render Free.
MAIL_PROVIDER=smtp
MAIL_HTTP_TIMEOUT=10000
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM=
